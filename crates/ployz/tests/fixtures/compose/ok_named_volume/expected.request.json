{
  "namespace_id": "fixture_named_volume",
  "volumes": {
    "cache": {
      "kind": "plain"
    },
    "data": {
      "kind": "provisioned",
      "max_size_bytes": 10737418240
    },
    "logs": {
      "kind": "plain"
    }
  },
  "services": [
    {
      "service_id": "long",
      "image": "nginx:latest",
      "mode": {
        "kind": "replicated",
        "replicas": 1
      },
      "runtime": {
        "command": null,
        "entrypoint": null,
        "environment": {},
        "stop_grace_period": 10,
        "volume_mounts": [
          {
            "volume_name": "cache",
            "target": "/cache"
          },
          {
            "volume_name": "logs",
            "target": "/logs"
          }
        ]
      }
    },
    {
      "service_id": "short",
      "image": "nginx:latest",
      "mode": {
        "kind": "replicated",
        "replicas": 1
      },
      "runtime": {
        "command": null,
        "entrypoint": null,
        "environment": {},
        "stop_grace_period": 10,
        "volume_mounts": [
          {
            "volume_name": "data",
            "target": "/data"
          }
        ]
      }
    }
  ]
}
