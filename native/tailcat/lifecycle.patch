+
+// Churn uses injected expiry; final cleanup exercises the real sweep timer.
+// All connections use a local DERP fixture.
+func TestBoundedClientLifecycle(t *testing.T) {
+	dm := integration.RunDERPAndSTUN(t, mkLogger(t, "derp"), "127.0.0.1")
+	started := make(chan struct{}, 1)
+	finished := make(chan struct{}, 1)
+	s := &Server{Region: dm.Regions[1], MaxClients: 4, ClientIdleTimeout: 2 * time.Second,
+		OnTCP: func(uint16) func(net.Conn) {
+			return func(c net.Conn) {
+				defer c.Close()
+				started <- struct{}{}
+				io.Copy(c, c)
+				finished <- struct{}{}
+			}
+		}}
+	if err := s.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	c := &Client{Server: s.TailcatAddr()}
+	defer c.Close()
+	conn, err := c.DialTCPPort(ctx, 80)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(25 * time.Second))
+	select {
+	case <-started:
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	echo := func() {
+		t.Helper()
+		if _, err := conn.Write([]byte("ok")); err != nil {
+			t.Fatal(err)
+		}
+		var got [2]byte
+		if _, err := io.ReadFull(conn, got[:]); err != nil {
+			t.Fatal(err)
+		}
+		if string(got[:]) != "ok" {
+			t.Fatal(string(got[:]))
+		}
+	}
+	echo()
+	for round := 0; round < 32; round++ {
+		// A meow is unauthenticated admission: no PSK proof, no successful TCP.
+		for i := 0; i < 3; i++ {
+			if !s.lb.onMeow(key.NewNode().Public(), key.NewDisco().Public()) {
+				t.Fatal("unexpected cap")
+			}
+		}
+		if s.lb.onMeow(key.NewNode().Public(), key.NewDisco().Public()) {
+			t.Fatal("admission cap exceeded")
+		}
+		s.lb.expireClients(time.Now().Add(2 * time.Hour))
+		s.lb.mu.Lock()
+		retained, lifetimes, peers := len(s.lb.clients), len(s.lb.lifetimes), len(s.lb.nm.Peers)
+		s.lb.mu.Unlock()
+		if retained != 1 || lifetimes != 1 || peers != 1 {
+			t.Fatalf("retained %d/%d/%d", retained, lifetimes, peers)
+		}
+		echo() // established WireGuard/TCP stream survives unrelated peer removal.
+	}
+	for round := 0; round < 3; round++ {
+		wrong, err := ParseAddr(s.TailcatAddr())
+		if err != nil {
+			t.Fatal(err)
+		}
+		wrong.PresharedKey = NewPresharedKey()
+		invalid := &Client{Server: wrong.Addr()}
+		attempt, stop := context.WithTimeout(ctx, 500*time.Millisecond)
+		stream, err := invalid.DialTCPPort(attempt, 80)
+		stop()
+		invalid.Close()
+		if err == nil {
+			stream.Close()
+			t.Fatal("wrong PSK established TCP")
+		}
+		s.lb.mu.Lock()
+		_, admitted := s.lb.clients[invalid.PublicKey()]
+		s.lb.mu.Unlock()
+		if !admitted {
+			t.Fatal("wrong-PSK test never reached admission")
+		}
+		s.lb.expireClients(time.Now().Add(2 * time.Hour))
+		s.lb.mu.Lock()
+		retained, lifetimes, peers := len(s.lb.clients), len(s.lb.lifetimes), len(s.lb.nm.Peers)
+		s.lb.mu.Unlock()
+		if retained != 1 || lifetimes != 1 || peers != 1 || enginePeers(s) != 1 {
+			t.Fatal("invalid handshake retained peer state")
+		}
+		echo()
+	}
+	for round := 0; round < 8; round++ {
+		transient := &Client{Server: s.TailcatAddr()}
+		stream, err := transient.DialTCPPort(ctx, 80)
+		if err != nil {
+			transient.Close()
+			t.Fatal(err)
+		}
+		stream.SetDeadline(time.Now().Add(5 * time.Second))
+		select {
+		case <-started:
+		case <-ctx.Done():
+			t.Fatal(ctx.Err())
+		}
+		if _, err := stream.Write([]byte("ok")); err != nil {
+			t.Fatal(err)
+		}
+		var got [2]byte
+		if _, err := io.ReadFull(stream, got[:]); err != nil {
+			t.Fatal(err)
+		}
+		stream.Close()
+		select {
+		case <-finished:
+		case <-ctx.Done():
+			t.Fatal(ctx.Err())
+		}
+		for {
+			s.lb.mu.Lock()
+			life := s.lb.lifetimes[transient.PublicKey()]
+			idle := life != nil && life.active == 0
+			s.lb.mu.Unlock()
+			if idle {
+				break
+			}
+			select {
+			case <-ctx.Done():
+				t.Fatal(ctx.Err())
+			default:
+				runtime.Gosched()
+			}
+		}
+		transient.Close()
+		s.lb.expireClients(time.Now().Add(2 * time.Hour))
+		s.lb.mu.Lock()
+		retained := len(s.lb.clients)
+		s.lb.mu.Unlock()
+		if retained != 1 {
+			t.Fatalf("successful churn retained %d clients", retained)
+		}
+		if enginePeers(s) != 1 {
+			t.Fatal("successful churn retained engine peers")
+		}
+		echo()
+	}
+	// Destroy a client network stack with its TCP connection still open, like
+	// a killed helper. The survivor stays silent and must ACK keepalive probes.
+	vanished := &Client{Server: s.TailcatAddr()}
+	abandoned, err := vanished.DialTCPPort(ctx, 80)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer abandoned.Close()
+	select {
+	case <-started:
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	vanished.Close()
+	select {
+	case <-finished:
+	case <-ctx.Done():
+		t.Fatal("vanished client pinned handler")
+	}
+	sweep := time.NewTicker(10 * time.Millisecond)
+	for {
+		s.lb.mu.Lock()
+		retained := len(s.lb.clients)
+		s.lb.mu.Unlock()
+		if retained == 1 && enginePeers(s) == 1 {
+			break
+		}
+		select {
+		case <-sweep.C:
+		case <-ctx.Done():
+			t.Fatal("vanished client retained peer")
+		}
+	}
+	sweep.Stop()
+	echo()
+	conn.Close()
+	select {
+	case <-finished:
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	// Handler defer updates lifetime just after sending finished; wait on its mutex
+	// through a completion barrier rather than a timing assumption.
+	for {
+		s.lb.mu.Lock()
+		active := 0
+		for _, life := range s.lb.lifetimes {
+			active += life.active
+		}
+		s.lb.mu.Unlock()
+		if active == 0 {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatal(ctx.Err())
+		default:
+			runtime.Gosched()
+		}
+	}
+	// No injected expiry here: prove the production timer clears the last peer.
+	poll := time.NewTicker(10 * time.Millisecond)
+	defer poll.Stop()
+	for {
+		s.lb.mu.Lock()
+		empty := len(s.lb.clients) == 0 && len(s.lb.nm.Peers) == 0 && len(s.lb.lifetimes) == 0
+		s.lb.mu.Unlock()
+		if empty && enginePeers(s) == 0 {
+			break
+		}
+		select {
+		case <-poll.C:
+		case <-ctx.Done():
+			t.Fatal("timer failed to remove successful peer")
+		}
+	}
+}
+
+func enginePeers(s *Server) int {
+	sb := &ipnstate.StatusBuilder{WantPeers: true}
+	s.lb.sys.Engine.Get().UpdateStatus(sb)
+	return len(sb.Status().Peer)
+}
