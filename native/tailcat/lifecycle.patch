+
+// clientLifetime belongs to an admitted peer, not an application session.
+type clientLifetime struct {
+	active    int
+	idleSince time.Time
+}
+
+func (b *locoBackend) trackTCP(ip netip.Addr, handler func(net.Conn)) func(net.Conn) {
+	if handler == nil || b.clientIdleTimeout == 0 {
+		return handler
+	}
+	return func(c net.Conn) {
+		// Keep live quiet streams, but let the stack terminate vanished clients.
+		// User timeout also bounds connections with unacknowledged payloads.
+		gc, ok := c.(*gonet.TCPConn)
+		if !ok {
+			c.Close()
+			return
+		}
+		raw, _ := gonetTCPConnInternals(gc)
+		ep := raw.(tcpip.Endpoint)
+		idle := tcpip.KeepaliveIdleOption(b.clientIdleTimeout)
+		interval := tcpip.KeepaliveIntervalOption(b.clientIdleTimeout)
+		timeout := tcpip.TCPUserTimeoutOption(b.clientIdleTimeout)
+		for _, option := range []tcpip.SettableSocketOption{&idle, &interval, &timeout} {
+			if err := ep.SetSockOpt(option); err != nil {
+				c.Close()
+				return
+			}
+		}
+		if err := ep.SetSockOptInt(tcpip.KeepaliveCountOption, 2); err != nil {
+			c.Close()
+			return
+		}
+		ep.SocketOptions().SetKeepAlive(true)
+		b.mu.Lock()
+		var lifetime *clientLifetime
+		for k := range b.clients {
+			if tcAddrForKey(k) == ip {
+				lifetime = b.lifetimes[k]
+				break
+			}
+		}
+		if lifetime != nil {
+			lifetime.active++
+		}
+		b.mu.Unlock()
+		if lifetime == nil {
+			c.Close()
+			return
+		}
+		defer func() { b.mu.Lock(); lifetime.active--; lifetime.idleSince = time.Now(); b.mu.Unlock() }()
+		handler(c)
+	}
+}
+
+func (b *locoBackend) expireClients(now time.Time) {
+	b.mu.Lock()
+	var removed []key.NodePublic
+	for k, life := range b.lifetimes {
+		if life.active == 0 && now.Sub(life.idleSince) >= b.clientIdleTimeout {
+			delete(b.clients, k)
+			delete(b.lifetimes, k)
+			removed = append(removed, k)
+		}
+	}
+	if len(removed) > 0 {
+		nm := *b.nm
+		nm.Peers = nil
+		for _, peer := range b.nm.Peers {
+			if _, ok := b.clients[peer.Key()]; ok {
+				nm.Peers = append(nm.Peers, peer)
+			}
+		}
+		b.nm = &nm
+		b.sys.MagicSock.Get().SetNetworkMap(nm.SelfNode, nm.Peers)
+		b.sys.Netstack.Get().UpdateNetstackIPs(&nm)
+	}
+	b.mu.Unlock()
+	// SyncDevicePeer consults peerConfig, which takes b.mu. Never hold it here.
+	for _, k := range removed {
+		b.sys.Engine.Get().SyncDevicePeer(k)
+	}
+}
