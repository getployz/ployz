{
  "name": "@ployz/sdk",
  "version": "0.1.2-beta.7",
  "description": "Ployz Cloud SDK. Public payloads are generated from Rust.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getployz/ployz2.git",
    "directory": "ployz-sdk"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.js",
      "browser": "./browser.mjs"
    },
    "./package.json": "./package.json",
    "./index.d.ts": "./index.d.ts"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.mjs",
    "generated"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
