{
  "name": "ployz-cloud",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bash ../scripts/build-cloud-sdk.sh && portless ployz-cloud vite dev",
    "build": "bash ../scripts/build-cloud-sdk.sh && vite build && node scripts/package-sdk.mjs",
    "start": "node scripts/start-with-inngest-sync.mjs",
    "preview": "vite preview",
    "intents:sync": "node scripts/sync-intent-descriptions.mjs",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:fresh": "node --env-file-if-exists=.env scripts/db-migrate-fresh.mjs && node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:reset": "node --env-file-if-exists=.env scripts/db-reset.mjs && node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "pr:check": "bash scripts/pr-check.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "pnpm dlx react-doctor@latest --verbose --blocking warning --yes",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@better-auth/drizzle-adapter": "^1.6.6",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@ployz/sdk": "link:../crates/ployz-sdk",
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/checkout": "^0.3.0",
    "@polar-sh/sdk": "^0.48.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/query-db-collection": "^1.2.1",
    "@tanstack/react-db": "^0.1.95",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-form": "2.0.0-alpha.0",
    "@tanstack/react-form-devtools": "1.0.0-alpha.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.30",
    "@xyflow/react": "^12.10.2",
    "better-auth": "^1.6.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.112",
    "inngest": "^4.2.4",
    "lucide-react": "^1.8.0",
    "minimatch": "^10.2.5",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@inngest/test": "1.0.0",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/start-storage-context": "1.167.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "inngest-cli": "1.44.0",
    "jsdom": "^29.0.2",
    "nitro": "3.0.260610-beta",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "0.24.0",
    "portless": "^0.15.6",
    "typescript": "7.0.1-rc",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@ployz/sdk-darwin-arm64": "0.1.2-beta.35",
    "@ployz/sdk-darwin-x64": "0.1.2-beta.35",
    "@ployz/sdk-linux-arm64": "0.1.2-beta.35",
    "@ployz/sdk-linux-x64": "0.1.2-beta.35"
  }
}
