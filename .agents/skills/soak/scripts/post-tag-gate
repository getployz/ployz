#!/usr/bin/env bash
# post-tag-gate <request-id> [timeout-minutes]
#
# Reads the coord mailbox (COORD_MAIL_DIR, default
# ~/.config/ployz-coord/mail) and prints the state of a post-tag request
# that release sent with coord-send:
#   ACKED    exit 0   the recipient mailed the sender a reply naming the
#                     request id within the timeout (default 15 minutes).
#   PENDING  exit 75  no such reply yet, still inside the timeout.
#   FAILED   exit 1   no such reply within the timeout, the recipient has no
#                     registered mailbox, or the request can't be found.
# FAILED is a failed release gate. A late reply doesn't reopen it; only a
# new request that is acknowledged in time does.
set -euo pipefail

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: post-tag-gate <request-id> [timeout-minutes]" >&2
  exit 2
fi
id=$1
timeout=${2:-15}
dir=${COORD_MAIL_DIR:-$HOME/.config/ployz-coord/mail}

fail() { echo "FAILED: $1"; exit 1; }
field() { sed -n "s/^$1: //p;/^\$/q" "$2"; }

shopt -s nullglob
found=("$dir"/inbox/*/"$id".md "$dir"/read/*/"$id".md)
[ ${#found[@]} -gt 0 ] || fail "request $id is not in the mailbox"
request=${found[0]}
to=$(field to "$request")
from=$(field from "$request")
sent=$(date -ud "$(field ts "$request")" +%s)
deadline=$(( sent + timeout * 60 ))

[ -f "$dir/names/$to.json" ] || fail "$to has no registered mailbox, so the request was never delivered"

for reply in "$dir"/inbox/"$from"/*.md "$dir"/read/"$from"/*.md; do
  [ "$(field from "$reply")" = "$to" ] || continue
  sed '1,/^$/d' "$reply" | grep -qF -- "$id" || continue
  if [ "$(date -ud "$(field ts "$reply")" +%s)" -le "$deadline" ]; then
    echo "ACKED: $to replied in $(basename "$reply" .md)"
    exit 0
  fi
done

now=$(date -u +%s)
[ "$now" -lt "$deadline" ] || fail "$to did not acknowledge $id within $timeout min"
echo "PENDING: $to has not acknowledged $id, $(( (deadline - now + 59) / 60 )) min left"
exit 75
