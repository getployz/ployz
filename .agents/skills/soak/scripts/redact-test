#!/usr/bin/env bash
# redact-test
#
# Feeds redact one line per Ployz token prefix and recovery code, built from
# obviously fake values, and checks each value is masked. Then feeds lines that only look
# token-shaped and checks they pass through unchanged. Prints one line per
# case and exits 1 on a mismatch.
set -euo pipefail

redact=$(dirname "$0")/redact
fake43=FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAK
failures=0

# check <case> <input> <want>
check() {
  local got
  got=$(printf '%s\n' "$2" | "$redact")
  if [ "$got" = "$3" ]; then
    echo "ok    $1"
  else
    echo "FAIL  $1: want '$3', got '$got'"
    failures=$(( failures + 1 ))
  fi
}
# masked <prefix> <fake body>
masked() { check "masks $1" "token $1$2 issued" "token $1<redacted> issued"; }
# kept <case> <input>
kept() { check "keeps $1" "$2" "$2"; }
# hidden <case> <input>: no FAKE or fa4e run survives, whatever stands in its place.
hidden() {
  local got
  got=$(printf '%s\n' "$2" | "$redact")
  case "$got" in
    *FAKE* | *fa4efa4e*) echo "FAIL  hides $1: got '$got'"; failures=$(( failures + 1 )) ;;
    *) echo "ok    hides $1" ;;
  esac
}

masked ployz_ "$fake43"
masked pflt_ "$fake43"
masked pmet_ "$fake43"
masked ppair_ "$fake43"
masked plyz_ "$fake43"
masked ployz1: "${fake43}${fake43}"
masked ployzgrant1: "FAKE.FAKE:FAKE"
check "masks recovery code field" "Recovery code  FAKEA-FAKEB-FAKEC-FAKED-FAKE22" "Recovery code  <redacted recovery code>"
check "masks recovery code in JSON" '{"recoveryCode":"FAKE2-FAKE3-FAKE4-FAKE5-FAKE67"}' '{"recoveryCode":"<redacted recovery code>"}'
# In a JSON string a newline is the two characters \n, so a word char sits right before the prefix (#3618).
for esc in '\n' '\t' '\r' '\"' '\u000a'; do
  for prefix in ployz_ pflt_ pmet_ ppair_ plyz_ ployz1:; do
    check "masks $prefix after $esc" "\"x${esc}${prefix}${fake43}${esc}\"" "\"x${esc}${prefix}<redacted>${esc}\""
  done
  check "masks ployzgrant1: after $esc" "\"x${esc}ployzgrant1:FAKE.FAKE:FAKE\"" "\"x${esc}ployzgrant1:<redacted>\""
  check "masks recovery code after $esc" "\"x${esc}FAKEA-FAKEB-FAKEC-FAKED-FAKE22${esc}\"" "\"x${esc}<redacted recovery code>${esc}\""
done
check "masks JWT after \\n" '"x\neyJFAKE.eyJFAKE.FAKE"' '"x\n<redacted JWT>"'
check "masks Bearer after \\n" '"x\nBearer FAKEFAKEFAKE"' '"x\nBearer <redacted>"'
check "masks PLOYZ_TOKEN after \\n" '"x\nPLOYZ_TOKEN=FAKEFAKE"' '"x\nPLOYZ_TOKEN=<redacted>"'
check "masks the #3618 repro" 'x\npflt_FAKEFAKEFAKEFAKE1234 "a\nployz_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"' 'x\npflt_<redacted> "a\nployz_<redacted>"'
# Fleet Tokens and enrollment tokens in every form a soak transcript has shown them.
esc=$'\e'
for prefix in pflt_ pmet_; do
  t=$prefix$fake43
  for form in "@" '\n@\n' '{"value":"@"}' '{"out":"line\n@\n"}' \
    'https://ployz.cloud/enroll?token=@&x=1' 'https://h/x?u=a%0A@' 'https://h/x?q=%22@%22' \
    'sudo PLOYZ_FLEET_TOKEN=@ sh -s -- 0.3.10 --enroll' 'export PLOYZ_ENROLL_TOKEN="@"' \
    'ployz server add --token=@' 'x\x0a@' 'x\012@' "${esc}[1m@${esc}[0m"; do
    check "masks $prefix in $form" "${form//@/$t}" "${form//@/$prefix<redacted>}"
  done
done
# Dev-dashboard session cookies (#3634): hex token, a dot, base64 HMAC, raw or URL-encoded.
hex32=fa4efa4efa4efa4efa4efa4efa4efa4e
sig='FAKE+fake/FAKE+fake/FAKE+fake/FAKE+fake/FAK='
sig_url='FAKE%2Bfake%2FFAKE%2Bfake%2FFAKE%2Bfake%2FFAKE%2Bfake%2FFAK%3D'
for cookie in "$hex32.$sig" "$hex32.$sig_url" "$hex32$hex32.$sig" "$hex32$hex32.$sig_url"; do
  check "masks a bare session cookie" "$cookie" "<redacted session cookie>"
  for form in 'Cookie: better-auth.session_token=@; other=1' \
    'set-cookie: better-auth.session_token=@; Path=/; HttpOnly' \
    'curl -H "Cookie: better-auth.session_token=@" http://127.0.0.1:5173/cloud' \
    'VERIFY_SEED {"organizationSlug":"ada","cookie":"@","grace":"@","linus":"@"}' \
    '{"name":"better-auth.session_token","value":"@"}' \
    'http://127.0.0.1:5173/cloud?session=@&x=1' \
    'agent-browser --session s cookies set better-auth.session_token @ --url http://x' \
    '"x\n@\n"'; do
    hidden "session cookie in $form" "${form//@/$cookie}"
  done
done
kept "up.sh's cookie hint, which reads a file" "  agent-browser --session s cookies set better-auth.session_token \"\$(cat '/x/.verify/run/cookie')\" --url http://x --httpOnly"
kept "a session_token from a shell variable" 'curl -b better-auth.session_token=$cookie http://x'
check "masks a session_token value" 'better-auth.session_token=FAKEFAKE; Path=/' 'better-auth.session_token=<redacted>; Path=/'
kept "a commit hash and a dotted name" "fa4efa4efa4efa4efa4efa4efa4efa4efa4efa4e.patch applied"
check "masks ployz_ with - and _" "ployz_FAKE-FAKE_FAKE-FAKE_FAKE-FAKE_FAKE-FAKE" "ployz_<redacted>"

kept "cookie-name ployz_ identifier" "set ployz_claim_sign_in to expire"
kept "short ployz_ test fixture" "Secret::new(\"ployz_secret\")"
kept "ployz_ in snake case" "my_ployz_FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE"
kept "bare prefix in prose" "Organization Tokens start with \`ployz_\` and capabilities with \`ployz1:\`"
kept "lowercase 5-5-5-5-6 slug" "image local-first-hello-world-server pulled"
kept "uppercase groups with digits outside base32" "ABCDE-FGHIJ-KLMNO-PQRST-UVWXY0"
kept "longer dashed uppercase run" "XFAKEA-FAKEB-FAKEC-FAKED-FAKE22"
kept "ployz_ name after an escape" 'a\nployz_claim_sign_in'
kept "prefix glued to a word" "xpflt_FAKEFAKE"
kept "plain log line" "deploy web: 3 containers healthy on machine-a"

[ "$failures" -eq 0 ] || { echo "$failures case(s) failed"; exit 1; }
echo "all cases passed"
