#!/usr/bin/env bash
# mirror-https <run-manifest> <mirror-dir> [machine]
#
# Serves <mirror-dir>, as release-mirror lays it out, over https from a Machine of a `verify-cluster up --bare`
# run (machine-1 by default). Caddy on the host network gets a Let's Encrypt certificate for the Machine's IPv6
# address on sslip.io in seconds; bare Boat hosts already allow 80 and 443. Prints the mirror's URL. The host has
# only an IPv6 address, so only IPv6 hosts reach it. Run it again to replace the files; `down` removes the host.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: mirror-https <run-manifest> <mirror-dir> [machine]" >&2
  exit 2
fi
manifest=$1 mirror=$2 machine=${3:-machine-1}
[ -f "$mirror/install.sh" ] || { echo "mirror-https: $mirror has no install.sh; lay it out with release-mirror" >&2; exit 2; }
read -r cluster address < <(python3 -c '
import json, sys
run = json.load(open(sys.argv[1]))
node = next(node for node in run["machines"] if node["name"] == sys.argv[2])
print(run["root"] + "/scripts/verify-cluster", node["address"])' "$manifest" "$machine")
case $address in *:*) ;; *) echo "mirror-https: $machine has no IPv6 address ($address)" >&2; exit 1 ;; esac
host=$(printf %s "$address" | tr : -).sslip.io

tar -C "$mirror" -cf - . | "$cluster" exec "$manifest" "$machine" -- bash -ec 'rm -rf /srv/mirror; mkdir -p /srv/mirror; tar -x -C /srv/mirror'
# shellcheck disable=SC2016 # the host's shell expands these
"$cluster" exec "$manifest" "$machine" -- bash -ec '
mkdir -p /etc/mirror
printf "%s {\n  root * /srv/mirror\n  file_server\n}\n" "$1" > /etc/mirror/Caddyfile
docker rm -f mirror >/dev/null 2>&1 || true
docker run -d --name mirror --restart unless-stopped --network host -v /etc/mirror/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v /srv/mirror:/srv/mirror:ro -v mirror-caddy:/data caddy:2 >/dev/null
for _ in $(seq 60); do curl -fs -o /dev/null "https://$1/install.sh" && exit 0; sleep 2; done
echo "Caddy did not serve https://$1 within 2 minutes; see docker logs mirror" >&2; exit 1' mirror "$host"
echo "https://$host"
