#!/usr/bin/env bash
# setup <app-url> <version>     on the self-host lab's host, as root, from the directory holding these files
#
# Installs Ployz Cloud <version> (v0.3.8, say) by docs/user/self-hosting.md into /root/ployz-cloud, with a fake
# GitHub for sign-in, then serves it at <app-url> (https://MY-SERVER) through Caddy and Let's Encrypt. On a bare
# Boat host, MY-SERVER is the host's IPv6 address with dashes on sslip.io. Every secret is generated here and stays
# in /root/ployz-cloud/.env, mode 600; nothing is printed. Rerunning keeps .env and redeploys.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: setup <app-url> <version>" >&2
  exit 2
fi
app=${1%/} version=v${2#v}
lab=$(cd "$(dirname "$0")" && pwd)
dir=/root/ployz-cloud
mkdir -p "$dir/fake"
cd "$dir"

# Step 2 of the doc: the release's compose file and .env, then the secrets.
curl -fsSLo compose.yml "https://github.com/getployz/ployz/releases/download/$version/ployz-cloud-compose.yml"
if [ ! -f .env ]; then
  (umask 077; curl -fsSLo .env "https://github.com/getployz/ployz/releases/download/$version/ployz-cloud.env.example")
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out fake/app.pem 2>/dev/null
  python3 - "$app" fake/app.pem <<'PY'
import re, secrets, sys
app, key = sys.argv[1], open(sys.argv[2]).read().strip()
values = {name: secrets.token_hex(32) for name in
          ["POSTGRES_PASSWORD", "BETTER_AUTH_SECRET", "APP_ENCRYPTION_SECRET", "INNGEST_EVENT_KEY", "INNGEST_SIGNING_KEY",
           "GITHUB_APP_WEBHOOK_SECRET"]}
# The fake GitHub accepts any client; these only have to be present.
values.update(APP_URL=app, GITHUB_CLIENT_ID="Iv1.labfakeoauth", GITHUB_CLIENT_SECRET="labfakeoauthsecret",
              GITHUB_APP_ID="123456", GITHUB_APP_SLUG="lab-fake-app", GITHUB_APP_CLIENT_ID="Iv1.labfakeapp",
              GITHUB_APP_CLIENT_SECRET="labfakeappsecret")
env = open(".env").read()
env, found = re.subn(r'^GITHUB_APP_PRIVATE_KEY=".*?"', lambda _: f'GITHUB_APP_PRIVATE_KEY="{key}"', env, count=1, flags=re.M | re.S)
assert found == 1, "GITHUB_APP_PRIVATE_KEY"
for name, value in values.items():
    env, found = re.subn(rf"^#? ?{name}=.*$", lambda _: f"{name}={value}", env, count=1, flags=re.M)
    assert found == 1, name
open(".env", "w").write(env)
PY
  rm -f fake/app.pem
fi

# The fake GitHub: a CA web and worker trust, and its certificate for github.com and api.github.com.
if [ ! -f fake/ca.pem ]; then
  openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj /CN=lab-fake-ca -keyout fake/ca.key -out fake/ca.pem 2>/dev/null
  openssl req -newkey rsa:2048 -nodes -subj /CN=github.com -keyout fake/srv.key -out fake/srv.csr 2>/dev/null
  printf 'subjectAltName=DNS:github.com,DNS:api.github.com\n' > fake/san.ext
  openssl x509 -req -in fake/srv.csr -CA fake/ca.pem -CAkey fake/ca.key -CAcreateserial -days 30 -extfile fake/san.ext \
    -out fake/srv.pem 2>/dev/null
  rm -f fake/srv.csr fake/san.ext fake/ca.key fake/ca.srl
  chmod 644 fake/srv.key
fi
cp "$lab/fakegh.py" fake/fakegh.py
cp "$lab/compose.override.yml" compose.override.yml

# Step 3 of the doc.
docker compose pull -q
docker compose run --rm web npm run db:migrate
docker compose up -d
for _ in $(seq 90); do
  [ "$(docker inspect -f '{{.State.Health.Status}}' "$(docker compose ps -q worker)" 2>/dev/null)" = healthy ] && break
  sleep 2
done

# The doc's TLS proxy: Caddy on this host.
host=${app#https://}
mkdir -p /etc/lab-caddy
printf '%s {\n  reverse_proxy localhost:3000\n}\n' "$host" > /etc/lab-caddy/Caddyfile
docker rm -f lab-caddy >/dev/null 2>&1 || true
docker run -d --name lab-caddy --restart unless-stopped --network host -v /etc/lab-caddy/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v lab-caddy:/data caddy:2 >/dev/null
for _ in $(seq 60); do curl -fs -o /dev/null "$app/api/auth/get-session" && break; sleep 2; done
docker compose ps --format '{{.Service}} {{.Status}}'
curl -fsS -o /dev/null -w "$app %{http_code}\n" "$app/api/auth/get-session"
