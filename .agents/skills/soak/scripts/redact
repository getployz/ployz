#!/usr/bin/env perl
# redact: copy stdin to stdout with secrets masked, line by line and unbuffered,
# so it can sit before a `tee` on a long-running command.
#
#   cmd 2>&1 | redact | tee log
#   grep -r marker scratch/ | redact
#
# Masks Ployz token values (ployz_, pflt_, pmet_, ppair_, plyz_, ployz1:,
# ployzgrant1:), Cluster recovery codes, JWTs, Cookie and Set-Cookie values,
# session_token values, Authorization values, PLOYZ_TOKEN, invite links, JSON
# fields named like a token, cookie, password or secret, and whole PEM blocks. A masked value reads <redacted>; the prefix or name stays.
use strict;
use warnings;

$| = 1;
my $pem = 0;
my $json_key = qr/[A-Za-z_]*(?:[Tt]oken|[Cc]ookie|[Pp]assword|[Ss]ecret)[A-Za-z_]*/;
# Where a secret can start: a word boundary, or right after a JSON or C string
# escape (\n, \t, \u000a), whose last character is a letter or digit so \b misses it.
my $start = qr/(?:\b|(?<=\\[bfnrt])|(?<=\\u[0-9A-Fa-f]{4}))/;

while (my $line = <STDIN>) {
    if ($pem) {
        $pem = 0 if $line =~ /-----END [A-Z0-9 ]+-----/;
        next;
    }
    if ($line =~ /-----BEGIN [A-Z0-9 ]+-----/) {
        print "<redacted PEM block>\n";
        $pem = 1 unless $line =~ /-----END [A-Z0-9 ]+-----/;
        next;
    }

    $line =~ s/${start}(pflt_|plyz_|pmet_|ppair_)[A-Za-z0-9_\-]+/$1<redacted>/g;
    # Organization Tokens carry 43 base64url chars; the floor spares names like ployz_claim_sign_in.
    $line =~ s/${start}(ployz_)[A-Za-z0-9_\-]{32,}/$1<redacted>/g;
    # A full-length token is masked even when glued to a URL escape (%0A), a terminal colour code or \x0a.
    # Only a snake_case name like my_ployz_… is spared.
    $line =~ s/(?<!_)(pflt_|plyz_|pmet_|ppair_|ployz_)[A-Za-z0-9_\-]{32,}/$1<redacted>/g;
    $line =~ s/${start}(ployz1:)[A-Za-z0-9_\-]+/$1<redacted>/g;
    $line =~ s/${start}(ployzgrant1:)[A-Za-z0-9._~+\/=:\-]+/$1<redacted>/g;
    # A recovery code prints as five dash-joined groups of uppercase base32 (A-Z, 2-7): 5-5-5-5-6.
    $line =~ s/${start}[A-Z2-7]{5}(?:-[A-Z2-7]{5}){3}-[A-Z2-7]{6}\b/<redacted recovery code>/g;
    $line =~ s/${start}eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]*/<redacted JWT>/g;
    $line =~ s/((?:^|["'\s])(?:set-)?cookie:\s*)[^"'\r\n]+/$1<redacted>/ig;
    $line =~ s/(authorization:\s*(?:bearer\s+|basic\s+)?)[^\s"',]+/$1<redacted>/ig;
    $line =~ s/(${start}bearer\s+)[A-Za-z0-9._~+\/=\-]{8,}/$1<redacted>/ig;
    $line =~ s/(session_token["']?(?:\s*[=:]\s*|\s+)["']?)[^\s"';,&]+/$1<redacted>/g;
    $line =~ s/(${start}PLOYZ_TOKEN=["']?)[^\s"']+/$1<redacted>/g;
    $line =~ s/(\/invite\/)[A-Za-z0-9_\-]+/$1<redacted>/g;
    $line =~ s/("$json_key"\s*:\s*")[^"]*"/$1<redacted>"/g;

    print $line;
}
