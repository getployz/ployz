#!/usr/bin/env perl
# redact: copy stdin to stdout with secrets masked, line by line and unbuffered,
# so it can sit before a `tee` on a long-running command.
#
#   cmd 2>&1 | redact | tee log
#   grep -r marker scratch/ | redact
#
# Masks Ployz token values (pflt_, plyz_, pmet_, ployzgrant1:), JWTs, Cookie
# and Set-Cookie values, session_token values, Authorization values, PLOYZ_TOKEN,
# invite links, JSON fields named like a token, cookie, password or secret, and
# whole PEM blocks. A masked value reads <redacted>; the prefix or name stays.
use strict;
use warnings;

$| = 1;
my $pem = 0;
my $json_key = qr/[A-Za-z_]*(?:[Tt]oken|[Cc]ookie|[Pp]assword|[Ss]ecret)[A-Za-z_]*/;

while (my $line = <STDIN>) {
    if ($pem) {
        $pem = 0 if $line =~ /-----END [A-Z0-9 ]+-----/;
        next;
    }
    if ($line =~ /-----BEGIN [A-Z0-9 ]+-----/) {
        print "<redacted PEM block>\n";
        $pem = 1 unless $line =~ /-----END [A-Z0-9 ]+-----/;
        next;
    }

    $line =~ s/\b(pflt_|plyz_|pmet_)[A-Za-z0-9_\-]+/$1<redacted>/g;
    $line =~ s/\b(ployzgrant1:)[A-Za-z0-9._~+\/=:\-]+/$1<redacted>/g;
    $line =~ s/\beyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]*/<redacted JWT>/g;
    $line =~ s/((?:^|["'\s])(?:set-)?cookie:\s*)[^"'\r\n]+/$1<redacted>/ig;
    $line =~ s/(authorization:\s*(?:bearer\s+|basic\s+)?)[^\s"',]+/$1<redacted>/ig;
    $line =~ s/(\bbearer\s+)[A-Za-z0-9._~+\/=\-]{8,}/$1<redacted>/ig;
    $line =~ s/(session_token["']?(?:\s*[=:]\s*|\s+)["']?)[^\s"';,&]+/$1<redacted>/g;
    $line =~ s/(\bPLOYZ_TOKEN=["']?)[^\s"']+/$1<redacted>/g;
    $line =~ s/(\/invite\/)[A-Za-z0-9_\-]+/$1<redacted>/g;
    $line =~ s/("$json_key"\s*:\s*")[^"]*"/$1<redacted>"/g;

    print $line;
}
