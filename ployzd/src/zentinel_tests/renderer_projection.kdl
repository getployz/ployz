schema-version "1.0"

system {
    auto-reload #false
}

listeners {
    listener "ployz-http" {
        address "0.0.0.0:80"
        protocol "http"
        request-timeout-secs 60
        keepalive-timeout-secs 75
    }

    listener "ployz-https" {
        address "0.0.0.0:443"
        protocol "https"
        namespace "ployz-https"
        request-timeout-secs 60
        keepalive-timeout-secs 75

        tls {
            cert-file "/config/certs/ployz-bootstrap.crt"
            key-file "/config/certs/ployz-bootstrap.key"
            min-version "TLS1.2"

            sni {
                hostnames "secure.example.com"
                cert-file "/config/certs/secure.example.com-1d660d5cdaeaac5dcae6e864c8ee63cd0a4483556f2e1d3bf8d66b2e8bc74e67.crt"
                key-file "/config/certs/secure.example.com-1d660d5cdaeaac5dcae6e864c8ee63cd0a4483556f2e1d3bf8d66b2e8bc74e67.key"
            }
        }
    }

    listener "ployz-admin-7fea0e6032bb92f9cc4f67fd0838b5563fc40835d520ee514720bab4b9f7a052" {
        address "127.0.0.1:2019"
        protocol "http"
        namespace "ployz-admin"
        request-timeout-secs 5
        keepalive-timeout-secs 5
    }
}

routes {
    route "ployz-verify" {
        priority "critical"
        matches {
            path "/.ployz-verify"
        }
        static-files {
            root "/config/verify"
            directory-listing #false
            cache-control "no-store"
            compress #false
        }
    }
    route "ployz-challenge-example.com" {
        priority "critical"
        matches {
            host "example.com"
            path "/.well-known/acme-challenge/token"
        }
        static-files {
            root "/config/challenges/example.com"
            directory-listing #false
            cache-control "no-store"
            compress #false
        }
    }
    route "ployz-http-empty.example.com" {
        priority "normal"
        matches {
            host "empty.example.com"
        }
        upstream "ployz-http-empty.example.com"
        websocket #true
        retry-policy {
            max-attempts 3
        }
    }
    route "ployz-http-example.com" {
        priority "normal"
        matches {
            host "example.com"
        }
        upstream "ployz-http-example.com"
        websocket #true
        retry-policy {
            max-attempts 3
        }
    }
}

upstreams {
    upstream "ployz-http-empty.example.com" {
        target "127.0.0.1:0"
        load-balancing "round_robin"

        circuit-breaker {
            failure-threshold 5
            success-threshold 2
            timeout-seconds 30
            half-open-max-requests 1
        }

        timeouts {
            connect-secs 1
            request-secs 2
            read-secs 2
            write-secs 2
        }
    }
    upstream "ployz-http-example.com" {
        target "10.210.1.2:8080"
        target "10.210.2.2:8080"
        load-balancing "round_robin"

        circuit-breaker {
            failure-threshold 5
            success-threshold 2
            timeout-seconds 30
            half-open-max-requests 1
        }
    }
    upstream "ployz-https-secure.example.com" {
        target "10.210.1.3:8443"
        load-balancing "round_robin"

        circuit-breaker {
            failure-threshold 5
            success-threshold 2
            timeout-seconds 30
            half-open-max-requests 1
        }
    }
}

namespace "ployz-https" {
    routes {
        route "ployz-https-secure.example.com" {
            priority "normal"
            matches {
                host "secure.example.com"
            }
            upstream "ployz-https-secure.example.com"
            websocket #true
            retry-policy {
                max-attempts 3
            }
        }
    }
}

namespace "ployz-admin" {
    routes {
        route "ployz-config" {
            priority "critical"
            matches {
                path "/config"
            }
            service-type "builtin"
            builtin-handler "config"
        }
    }
}

observability {
    metrics {
        enabled #true
        address "127.0.0.1:9090"
        path "/metrics"
        high-cardinality #false
    }

    logging {
        level "info"
        format "json"

        access-log {
            enabled #true
            file "/dev/stdout"
            format "json"
        }

        error-log {
            enabled #false
        }
    }
}
