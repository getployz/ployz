{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeployManifest",
  "type": "object",
  "required": [
    "namespace",
    "services"
  ],
  "properties": {
    "intent": {
      "anyOf": [
        {
          "$ref": "#/definitions/DeployIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "namespace": {
      "$ref": "#/definitions/Namespace"
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ServiceSpec"
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/VolumeDeclaration"
      }
    }
  },
  "definitions": {
    "ContainerSpec": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "cap_add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cap_drop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "entrypoint": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "image": {
          "type": "string"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mount"
          }
        },
        "pid_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "privileged": {
          "default": false,
          "type": "boolean"
        },
        "pull_policy": {
          "default": "if_not_present",
          "allOf": [
            {
              "$ref": "#/definitions/PullPolicy"
            }
          ]
        },
        "resources": {
          "default": {},
          "allOf": [
            {
              "$ref": "#/definitions/Resources"
            }
          ]
        },
        "stop_grace_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "sysctls": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DeployIntent": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeployPhaseIntent"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServiceIntentHint"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VolumeIntentHint"
          }
        }
      },
      "additionalProperties": false
    },
    "DeployPhaseAdvancePolicy": {
      "type": "string",
      "enum": [
        "immediate",
        "manual"
      ]
    },
    "DeployPhaseCommitPolicy": {
      "type": "string",
      "enum": [
        "end_of_deploy",
        "checkpoint",
        "no_store_commit"
      ]
    },
    "DeployPhaseIntent": {
      "type": "object",
      "required": [
        "phase_id"
      ],
      "properties": {
        "advance_policy": {
          "default": "immediate",
          "allOf": [
            {
              "$ref": "#/definitions/DeployPhaseAdvancePolicy"
            }
          ]
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commit_policy": {
          "default": "end_of_deploy",
          "allOf": [
            {
              "$ref": "#/definitions/DeployPhaseCommitPolicy"
            }
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase_id": {
          "type": "string"
        },
        "rollback_policy": {
          "default": "reversible",
          "allOf": [
            {
              "$ref": "#/definitions/DeployPhaseRollbackPolicy"
            }
          ]
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DeployPhaseRollbackPolicy": {
      "type": "string",
      "enum": [
        "reversible",
        "forward_only",
        "external"
      ]
    },
    "HttpRoute": {
      "type": "object",
      "required": [
        "service_port"
      ],
      "properties": {
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_prefix": {
          "default": "/",
          "type": "string"
        },
        "service_port": {
          "type": "string"
        }
      }
    },
    "Mount": {
      "type": "object",
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "readonly": {
          "default": false,
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/MountSource"
        },
        "target": {
          "type": "string"
        }
      }
    },
    "MountSource": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "tmpfs"
          ]
        },
        {
          "type": "object",
          "required": [
            "volume"
          ],
          "properties": {
            "volume": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "bind"
          ],
          "properties": {
            "bind": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Namespace": {
      "type": "string"
    },
    "NetworkMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "overlay",
            "host",
            "none"
          ]
        },
        {
          "type": "object",
          "required": [
            "service"
          ],
          "properties": {
            "service": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "NonZeroReplicaCount": {
      "type": "integer",
      "format": "uint16",
      "minimum": 1.0
    },
    "Placement": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "global"
          ]
        },
        {
          "type": "object",
          "required": [
            "replicated"
          ],
          "properties": {
            "replicated": {
              "type": "object",
              "required": [
                "count"
              ],
              "properties": {
                "count": {
                  "$ref": "#/definitions/NonZeroReplicaCount"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "PortProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ]
    },
    "PublishedPort": {
      "type": "object",
      "required": [
        "host_port",
        "service_port"
      ],
      "properties": {
        "host_ip": {
          "type": [
            "string",
            "null"
          ]
        },
        "host_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "service_port": {
          "type": "string"
        }
      }
    },
    "PullPolicy": {
      "type": "string",
      "enum": [
        "if_not_present",
        "always",
        "never"
      ]
    },
    "ReadinessProbe": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "http"
          ],
          "properties": {
            "http": {
              "type": "object",
              "required": [
                "path",
                "service_port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "service_port": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "tcp"
          ],
          "properties": {
            "tcp": {
              "type": "object",
              "required": [
                "service_port"
              ],
              "properties": {
                "service_port": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "exec"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "properties": {
        "interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "retries": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "start_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Resources": {
      "type": "object",
      "properties": {
        "cpu_millicores": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "RestartPolicy": {
      "type": "string",
      "enum": [
        "unless-stopped",
        "always",
        "on-failure",
        "no"
      ]
    },
    "RolloutStrategy": {
      "type": "string",
      "enum": [
        "recreate",
        "blue_green"
      ]
    },
    "RouteSpec": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "http"
          ],
          "properties": {
            "http": {
              "$ref": "#/definitions/HttpRoute"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "tcp"
          ],
          "properties": {
            "tcp": {
              "$ref": "#/definitions/TcpRoute"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ServiceIntent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "branch"
          ],
          "properties": {
            "branch": {
              "type": "object",
              "required": [
                "source_namespace",
                "source_service"
              ],
              "properties": {
                "expected_source_revision_hash": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_namespace": {
                  "$ref": "#/definitions/Namespace"
                },
                "source_service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "move"
          ],
          "properties": {
            "move": {
              "type": "object",
              "required": [
                "to_machine"
              ],
              "properties": {
                "to_machine": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "portal"
          ],
          "properties": {
            "portal": {
              "type": "object",
              "required": [
                "source_namespace",
                "source_service"
              ],
              "properties": {
                "source_namespace": {
                  "$ref": "#/definitions/Namespace"
                },
                "source_service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ServiceIntentHint": {
      "type": "object",
      "required": [
        "intent",
        "service"
      ],
      "properties": {
        "intent": {
          "$ref": "#/definitions/ServiceIntent"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ServicePort": {
      "type": "object",
      "required": [
        "container_port",
        "name"
      ],
      "properties": {
        "container_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        },
        "protocol": {
          "default": "tcp",
          "allOf": [
            {
              "$ref": "#/definitions/PortProtocol"
            }
          ]
        }
      }
    },
    "ServiceSpec": {
      "type": "object",
      "required": [
        "name",
        "network",
        "placement",
        "template"
      ],
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "network": {
          "$ref": "#/definitions/NetworkMode"
        },
        "placement": {
          "$ref": "#/definitions/Placement"
        },
        "publish": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublishedPort"
          }
        },
        "readiness": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReadinessProbe"
            },
            {
              "type": "null"
            }
          ]
        },
        "restart": {
          "default": "unless-stopped",
          "allOf": [
            {
              "$ref": "#/definitions/RestartPolicy"
            }
          ]
        },
        "rollout": {
          "default": "recreate",
          "allOf": [
            {
              "$ref": "#/definitions/RolloutStrategy"
            }
          ]
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RouteSpec"
          }
        },
        "service_ports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServicePort"
          }
        },
        "template": {
          "$ref": "#/definitions/ContainerSpec"
        }
      }
    },
    "TcpRoute": {
      "type": "object",
      "required": [
        "listen_port",
        "service_port"
      ],
      "properties": {
        "listen_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "service_port": {
          "type": "string"
        }
      }
    },
    "VolumeCloneConsistency": {
      "type": "string",
      "enum": [
        "crash_consistent"
      ]
    },
    "VolumeCloneDataPolicy": {
      "type": "string",
      "enum": [
        "raw"
      ]
    },
    "VolumeDeclaration": {
      "type": "object",
      "required": [
        "mode",
        "name",
        "owner",
        "quota",
        "scope"
      ],
      "properties": {
        "mode": {
          "$ref": "#/definitions/VolumeMode"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/definitions/VolumeOwner"
        },
        "quota": {
          "$ref": "#/definitions/VolumeQuota"
        },
        "scope": {
          "$ref": "#/definitions/VolumeScope"
        }
      }
    },
    "VolumeIntent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "move"
          ],
          "properties": {
            "move": {
              "type": "object",
              "required": [
                "from_machine",
                "to_machine"
              ],
              "properties": {
                "from_machine": {
                  "type": "string"
                },
                "to_machine": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "clone"
          ],
          "properties": {
            "clone": {
              "type": "object",
              "required": [
                "consistency",
                "data_policy",
                "source_namespace",
                "source_volume"
              ],
              "properties": {
                "consistency": {
                  "$ref": "#/definitions/VolumeCloneConsistency"
                },
                "data_policy": {
                  "$ref": "#/definitions/VolumeCloneDataPolicy"
                },
                "expected_source_record_fingerprint": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_namespace": {
                  "$ref": "#/definitions/Namespace"
                },
                "source_volume": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "VolumeIntentHint": {
      "type": "object",
      "required": [
        "intent",
        "volume"
      ],
      "properties": {
        "intent": {
          "$ref": "#/definitions/VolumeIntent"
        },
        "volume": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "VolumeMode": {
      "type": "string"
    },
    "VolumeOwner": {
      "type": "string"
    },
    "VolumeQuota": {
      "type": "string"
    },
    "VolumeScope": {
      "type": "string",
      "enum": [
        "single",
        "shared"
      ]
    }
  }
}
