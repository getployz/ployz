{
  "name": "@ployz/sdk",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated.ts"
  },
  "scripts": {
    "generate:types": "cargo run -p ployz-sdk-types --bin export-typescript > src/generated.ts",
    "generate:fixture": "cargo run -p ployz-sdk-types --bin export-operation-contract > test/fixtures/operation-contract.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@nats-io/transport-node": "^3.4.0"
  }
}
