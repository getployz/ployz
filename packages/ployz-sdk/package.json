{
  "name": "@ployz/sdk",
  "version": "0.0.2-alpha.28",
  "repository": {
    "type": "git",
    "url": "https://github.com/getployz/ployz"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated.ts"
  },
  "scripts": {
    "generate:types": "cargo run -p ployz-sdk-types --bin export-typescript > src/generated.ts",
    "generate:fixture": "cargo run -p ployz-sdk-types --bin export-operation-contract > test/fixtures/operation-contract.json",
    "check:generated": "pnpm generate:types && pnpm generate:fixture && git diff --exit-code -- src/generated.ts test/fixtures/operation-contract.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@nats-io/transport-node": "^3.4.0"
  }
}
