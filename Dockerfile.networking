# syntax=docker/dockerfile:1.7
FROM rust:1-bookworm AS builder

RUN rustup install nightly && \
    rustup target add --toolchain nightly x86_64-unknown-linux-musl aarch64-unknown-linux-musl && \
    rustup component add rust-src --toolchain nightly && \
    cargo +nightly install --locked bpf-linker
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY ebpf/ ebpf/
COPY scripts/ scripts/
ARG TARGETARCH
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    --mount=type=cache,target=/build/ebpf/target \
    if [ "$TARGETARCH" = "arm64" ]; then TARGET=aarch64-unknown-linux-musl; else TARGET=x86_64-unknown-linux-musl; fi && \
    CARGO_TARGET_DIR=/build/ebpf/target bash /build/scripts/build-ebpf-bytecode.sh && \
    cargo build --locked --release --target "$TARGET" -p ployz-bpfctl && \
    mkdir -p /build/release-bin && \
    cp /build/target/"$TARGET"/release/ployz-bpfctl /build/release-bin/ployz-bpfctl && \
    mkdir -p /build/release-assets && \
    cp /build/ebpf/target/bpfel-unknown-none/release/ployz-ebpf-tc /build/release-assets/ployz-ebpf-tc

FROM alpine:3.21
RUN apk add --no-cache wireguard-tools iproute2
COPY --from=builder /build/release-bin/ployz-bpfctl /usr/local/bin/ployz-bpfctl
COPY --from=builder /build/release-assets/ployz-ebpf-tc /usr/local/lib/ployz/ployz-ebpf-tc
CMD ["sleep", "infinity"]
