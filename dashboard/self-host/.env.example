# Self-hosted Cloud environment. Copy to .env beside compose.yml; every uncommented value is required.
# Walkthrough: dashboard/README.md → Self-host.

# Only for a checkout's self-host/compose.yml; the release asset pins the image tag.
# PLOYZ_CLOUD_VERSION=v0.2.0
# Public HTTPS URL of web, served by your TLS proxy in front of WEB_PORT (default 3000).
APP_URL=https://cloud.example.com
# WEB_PORT=3000

# Generate each secret with `openssl rand -hex 32`. Keep APP_ENCRYPTION_SECRET stable:
# it encrypts stored credentials.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
APP_ENCRYPTION_SECRET=
# Shared by the Inngest server and Cloud. The signing key must be hex.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# GitHub OAuth App (sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App (repository access). Quote the private key PEM across lines.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# Polar billing is Ployz-hosted only; leave every POLAR_* variable unset.
