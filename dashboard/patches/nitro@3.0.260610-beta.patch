+// Trap unhandled errors to avoid worker crash. Once the Nitro app is up, hand them to its captureError, as
+// production's trap does, so its plugins log them; printed raw, an error can carry a failed query's params.
+function trapped(type) {
+  return (error) => {
+    const app = globalThis.__nitro__?.default;
+    if (typeof app?.captureError === "function") app.captureError(error, { tags: [type] });
+    else console.error(error);
+  };
+}
