DATABASE_URL=postgres://postgres:postgres@127.0.0.1:8394/ployz_cloud
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32+-character-secret
BETTER_AUTH_TRUSTED_ORIGINS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
# Polar is optional: leave the token, webhook secret, and product ID blank for a Self-hosted Cloud without billing.
POLAR_ACCESS_TOKEN=
POLAR_SERVER=production
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# Inngest API and Connect gateway (local dev defaults need no overrides).
# INNGEST_BASE_URL=http://inngest.railway.internal:8288
# INNGEST_CONNECT_GATEWAY_URL=ws://inngest.railway.internal:8289/v0/connect
# INNGEST_CONNECT_MAX_WORKER_CONCURRENCY=10
# Required. The local dev server accepts any values.
INNGEST_EVENT_KEY=local-dev
INNGEST_SIGNING_KEY=signkey-dev-00
APP_ENCRYPTION_SECRET=replace-with-a-random-32+-character-secret
