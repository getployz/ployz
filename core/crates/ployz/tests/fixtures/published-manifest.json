      "idempotent": true,
      "open_world": false,
      "agents": true,
      "typed": null,
      "positional": [
        "name"
      ],
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "description": "The new name, e.g. acme"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
