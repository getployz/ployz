      "idempotent": true,
      "open_world": false,
      "agents": true,
      "typed": null,
      "positional": [
        "to"
      ],
      "input": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "description": "on or off. Turning it on waits for an owner or admin to approve and paste the Tailscale auth key in Ployz Cloud."
          }
        },
        "required": [
          "to"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "description": "on or off. Turning it on waits for an owner or admin to approve and paste the Tailscale auth key in Ployz Cloud."
          },
          "routers": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": [
                  "Infinity",
                  "-Infinity",
                  "NaN"
                ]
              }
            ]
          }
        },
        "required": [
          "to",
          "routers"
        ],
        "additionalProperties": false
      },
      "render": "message"
    },
