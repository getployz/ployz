        "name"
      ],
      "about": "Rename the Cluster. Every Service's long private address changes with it, e.g. db.prod.acme.ployz.internal",
      "title": "Rename the Cluster",
      "examples": [
        "ployz cluster name acme"
      ],
      "requires": "servers:operate",
      "kind": "write",
      "gate": "ask",
