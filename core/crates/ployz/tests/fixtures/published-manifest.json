    {
      "name": "server_upgrade_policy_set",
      "path": [
        "server",
        "upgrade-policy",
        "set"
      ],
      "about": "Change the Organization's upgrade policy: the Release Channel every upgrade follows, or automatic upgrades on or off",
      "examples": [
        "ployz server upgrade-policy set --channel beta",
        "ployz server upgrade-policy set --automatic true"
      ],
      "kind": "write",
      "gate": "never",
      "agents": true,
      "typed": null,
      "positional": [],
      "input": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "beta"
            ],
            "description": "The Release Channel every upgrade follows"
          },
          "automatic": {
            "type": "boolean",
            "description": "Whether Servers behind the channel upgrade on their own"
          }
        },
        "additionalProperties": false,
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "beta"
            ]
          },
          "automatic": {
            "type": "boolean"
          }
        },
        "required": [
          "channel",
          "automatic"
        ],
        "additionalProperties": false
      },
      "render": "record"
    },
