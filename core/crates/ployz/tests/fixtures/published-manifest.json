    {
      "name": "server_upgrade_policy_set",
      "path": [
        "server",
        "upgrade-policy",
        "set"
      ],
      "about": "Change the Organization's upgrade policy: its Release Channel, automatic upgrades on or off, or both. It takes effect at once, and turning automatic on starts a Rollout over the Servers that are behind",
      "title": "Change the upgrade policy",
      "examples": [
        "ployz server upgrade-policy set --channel beta",
        "ployz server upgrade-policy set --automatic true"
      ],
      "requires": "servers:operate",
      "kind": "write",
      "gate": "never",
      "removes": false,
      "idempotent": true,
      "open_world": false,
      "agents": true,
      "typed": null,
      "positional": [],
      "input": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "beta"
            ],
            "description": "The Release Channel every Upgrade follows from now on: stable or beta. Leave it out to keep the current one"
          },
          "automatic": {
            "type": "boolean",
            "description": "true lets Servers behind the channel upgrade on their own, false stops that. Leave it out to keep it as it is"
          }
        },
        "additionalProperties": false,
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "beta"
            ]
          },
          "automatic": {
            "type": "boolean"
          }
        },
        "required": [
          "channel",
          "automatic"
        ],
        "additionalProperties": false
      },
      "render": "record"
    },
    {
      "name": "cluster_rename",
