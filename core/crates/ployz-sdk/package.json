{
  "name": "@ployz/sdk",
  "private": true,
  "description": "Ployz Cloud SDK, consumed from the workspace. Public payloads are generated from Rust.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.js",
      "browser": "./browser.mjs"
    },
    "./package.json": "./package.json",
    "./index.d.ts": "./index.d.ts",
    "./config": {
      "types": "./config.d.ts",
      "default": "./config.mjs"
    }
  },
  "files": [
    "index.js",
    "runtime-logs.js",
    "index.d.ts",
    "browser.mjs",
    "generated",
    "config.mjs",
    "config.d.ts"
  ],
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
