#!/usr/bin/env python3
"""Disposable real-Machine verification; provider mechanics live in verify/."""

import argparse
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
import fcntl
import hashlib
import importlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
import uuid

CORE = Path(__file__).resolve().parents[1]
DASHBOARD = CORE.parent / "dashboard"
sys.dont_write_bytecode = True
sys.path.insert(0, str(CORE / "scripts" / "verify"))
sys.path.insert(0, str(CORE / "scripts"))
import artifacts  # noqa: E402
import boat  # noqa: E402
import host  # noqa: E402
import releases  # noqa: E402


class Infrastructure(RuntimeError):
    """A Machine the command needed is not running: the host failed, not the product."""


def save(run):
    path = Path(run["manifest"])
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(run, indent=2) + "\n")
    temporary.replace(path)


class Commands:
    def __init__(self, run):
        self.evidence = Path(run["manifest"]).parent / "evidence"
        self.evidence.mkdir(parents=True, exist_ok=True)
        self.lock = threading.Lock()

    def __call__(self, args, *, check=True, timeout=300, **kwargs):
        args = [str(arg) for arg in args]
        started = time.monotonic()
        stem = str(time.time_ns()) + "-" + uuid.uuid4().hex[:6]
        # Incus reads YAML from a non-terminal stdin, so an inherited open pipe hangs it until the timeout.
        if "input" not in kwargs:
            kwargs.setdefault("stdin", subprocess.DEVNULL)
        try:
            result = subprocess.run(args, capture_output=True, timeout=timeout, **kwargs)
        except subprocess.TimeoutExpired as error:
            result = subprocess.CompletedProcess(args, 124, error.stdout or b"",
                                                 (error.stderr or b"") + f"\nTimed out after {timeout}s\n".encode())
        (self.evidence / (stem + ".stdout")).write_bytes(result.stdout)
        (self.evidence / (stem + ".stderr")).write_bytes(result.stderr)
        event = dict(command=args, exit_code=result.returncode,
                     seconds=round(time.monotonic() - started, 3), artifact=stem)
        with self.lock, (self.evidence / "commands.jsonl").open("a") as output:
            output.write(json.dumps(event) + "\n")
        if check and result.returncode:
            detail = (result.stdout[-2000:] + result.stderr[-2000:]).decode(errors="replace")
            raise RuntimeError(f"{shlex.join(args)}\n{detail}\nEvidence: {self.evidence}")
        return result


PROVIDERS = ["incus", "boat"]


def provider(run, commands):
    # A backend implements prepare/create/start/exec/push/address/ssh/destroy.
    # The manifest binds subsequent operations to the provider that created it.
    if run["provider"] not in PROVIDERS:
        raise RuntimeError(f"Unknown provider: {run['provider']}")
    return importlib.import_module(run["provider"]).Provider(run, commands, CORE)


def parallel(function, items):
    with ThreadPoolExecutor(max_workers=len(items)) as workers:
        return list(workers.map(function, items))


def build(run, commands, *, daemon):
    """Put ployz, and for a LOCAL daemon source ployzd with its uninstaller, into the run's artifacts.

    Builds only what no cache holds; a main daemon is never built.
    """
    started = time.monotonic()
    destination = Path(run["manifest"]).parent / "artifacts"
    cargo_args = shlex.split(os.environ.get("PLOYZ_VERIFY_CARGO_ARGS", ""))
    names = ["ployz", *(["ployzd"] if daemon == "checkout" else [])]
    artifacts.binaries(destination, names, cargo_args, commands)
    if daemon == "main":
        if not artifacts.fetch_main(artifacts.key("ployzd", shlex.join(cargo_args)), destination, "--daemon checkout to build"):
            raise RuntimeError("--daemon main: no CI build of ployzd on main near this checkout's fork point")
        names.append("ployzd")
    if daemon:
        shutil.copy2(CORE / "scripts" / "uninstall.sh", destination / "ployz-uninstall")
        names.append("ployz-uninstall")
    hashes = {}
    for name in names:
        (destination / name).chmod(0o755)
        hashes[name] = hashlib.sha256((destination / name).read_bytes()).hexdigest()
    run["client_sha256"] = hashes["ployz"]
    if daemon:
        run["binaries"] = hashes
    run["timings"]["build"] = round(time.monotonic() - started, 3)
    run["revision"] = commands(["git", "rev-parse", "HEAD"], cwd=CORE).stdout.decode().strip()
    save(run)


def checkout_version():
    return re.search(r'^version = "([^"]+)"', (CORE / "Cargo.toml").read_text(), re.M).group(1)


# Daemon sources built from this repository, which share the run's artifacts; any other source is a release.
LOCAL = ("checkout", "main")


def local_daemon(daemons):
    """The run's one LOCAL daemon source, or None."""
    sources = {daemon["source"] for daemon in daemons if daemon["source"] in LOCAL}
    if len(sources) > 1:
        raise RuntimeError("--daemon checkout and --daemon main can't share a run")
    return next(iter(sources), None)


def daemon_binaries(run, daemon):
    return run["binaries"] if daemon["source"] in LOCAL else daemon["binaries"]


def daemon_artifacts(run, daemon):
    directory = Path(run["manifest"]).parent / "artifacts"
    return directory if daemon["source"] in LOCAL else directory / "runtime" / daemon["version"]


def select_daemons(run, commands, specs, *, default):
    """Apply --daemon [MACHINE=]SOURCE choices: a bare source sets every Machine, a named one overrides it."""
    names = [node["name"] for node in run["machines"]]
    chosen = {node["name"]: node.get("daemon", {}).get("source", default) for node in run["machines"]}
    bare = [spec for spec in specs if "=" not in spec]
    if len(bare) > 1:
        raise RuntimeError("Give at most one --daemon without a Machine name")
    if bare:
        chosen = dict.fromkeys(names, bare[0])
    for spec in specs:
        if "=" in spec:
            name, source = spec.split("=", 1)
            if name not in names:
                raise RuntimeError(f"--daemon {spec}: this run has no Machine named {name}")
            chosen[name] = source
    started = time.monotonic()
    versions = {}
    for node in run["machines"]:
        source = chosen[node["name"]]
        if source in LOCAL:
            node["daemon"] = {"source": source, "version": checkout_version()}
            continue
        if source not in versions:
            versions[source] = releases.resolve(source, commands, CORE)
        daemon = {"source": source, "version": versions[source]}
        daemon["binaries"] = releases.acquire(daemon["version"], commands, daemon_artifacts(run, daemon))
        node["daemon"] = daemon
    local_daemon([node["daemon"] for node in run["machines"]])
    run["timings"]["release_artifacts"] = round(time.monotonic() - started, 3)
    save(run)


def dashboard_state(dashboard):
    state = dashboard / ".verify" / "run"
    url = next(line.split("=", 1)[1] for line in (state / "env").read_text().splitlines() if line.startswith("APP_URL="))
    return url, json.loads((state / "seed.json").read_text())


def pair_cloud(private, commands, owns):
    """Start this checkout's dashboard verify instance, or attach to the one that started this run."""
    if owns:
        environment = {key: value for key, value in os.environ.items() if key != "SERVERS"}
        commands([DASHBOARD / "scripts" / "verify" / "up.sh"], env={**environment, "VERIFY_REAL_SERVERS": "1", "VERIFY_IDLE_TIMEOUT": "0"}, timeout=1800)
    url, seed = dashboard_state(DASHBOARD)
    (private / "cloud-token").write_text(seed["cliToken"])
    (private / "cloud-token").chmod(0o600)
    return dict(dashboard=str(DASHBOARD), url=url, organization=seed["organizationSlug"], owns_dashboard=owns)


def cli_environment(run):
    directory = Path(run["manifest"]).parent
    environment = {key: value for key, value in os.environ.items() if not key.startswith("PLOYZ_")}
    environment.update(PLOYZ_CONFIG=str(directory / "private" / "config.yaml"),
                       PATH=str(directory / "private" / "bin") + os.pathsep + os.environ["PATH"])
    if "cloud" in run:
        environment.update(PLOYZ_TOKEN=(directory / "private" / "cloud-token").read_text(), PLOYZ_CLOUD_URL=run["cloud"]["url"])
    else:
        environment.update(PLOYZ_CONTEXT="verify", PLOYZ_STORE="sqlite:" + str(directory / "private" / "store.sqlite"))
    return str(directory / "artifacts" / "ployz"), environment, directory / "workspace"


def cli(run, commands, args, **kwargs):
    ployz, environment, workspace = cli_environment(run)
    return commands([ployz, *args], cwd=workspace, env=environment, **kwargs)


PARTITION = """
tables=
for peer in "$@"; do
    case $peer in *:*) table=ip6tables ;; *) table=iptables ;; esac
    case " $tables " in
        *" $table "*) ;;
        *) tables="$tables $table"; $table -N PLOYZ-VERIFY-PARTITION 2>/dev/null || $table -F PLOYZ-VERIFY-PARTITION ;;
    esac
    $table -A PLOYZ-VERIFY-PARTITION -s "$peer" -j DROP
    $table -A PLOYZ-VERIFY-PARTITION -d "$peer" -j DROP
done
for table in $tables; do
    for hook in INPUT OUTPUT FORWARD; do
        $table -C "$hook" -j PLOYZ-VERIFY-PARTITION 2>/dev/null || $table -I "$hook" 1 -j PLOYZ-VERIFY-PARTITION
    done
done
"""

UNPARTITION = """
for table in iptables ip6tables; do
    for hook in INPUT OUTPUT FORWARD; do
        while $table -D "$hook" -j PLOYZ-VERIFY-PARTITION 2>/dev/null; do :; done
    done
    $table -F PLOYZ-VERIFY-PARTITION 2>/dev/null || true
    $table -X PLOYZ-VERIFY-PARTITION 2>/dev/null || true
done
"""


def endpoint(address):
    """The WireGuard endpoint on a Machine's underlay address."""
    return f"[{address}]:51820" if ":" in address else address + ":51820"


def partition(run, backend, node, cut):
    """Drop the Machine's traffic with each peer's underlay address, which carries WireGuard. The path SSH
    takes stays reachable, so SSH, the guest agent and Cloud still answer. The rules do not survive a reboot."""
    peers = [peer["address"] for peer in run["machines"] if peer is not node]
    backend.exec(node, ["bash", "-ec", PARTITION if cut else UNPARTITION, "partition", *peers])


def power(backend, node, on):
    if not on:
        backend.power_off(node)
        return
    backend.power_on(node)
    address = backend.address(node)
    if address != node["address"]:
        raise RuntimeError(f"{node['name']}: booted with address {address}, not {node['address']}")
    deadline = time.monotonic() + 180
    while backend.exec(node, ["systemctl", "is-active", "--quiet", "ployz", "docker"], check=False, timeout=10).returncode:
        if time.monotonic() >= deadline:
            raise RuntimeError(f"{node['name']}: ployz and docker were not active 180s after boot")
        time.sleep(1)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    return True


def runner(run, commands, on):
    """Kill or restart the Cloud Inngest worker this run's dashboard started. Inngest keeps the function runs and
    retries a lost step once a worker connects again."""
    if "cloud" not in run:
        raise RuntimeError("runner needs a --cloud run")
    dashboard = Path(run["cloud"]["dashboard"])
    pid = int((dashboard / ".verify" / "run" / "worker.pid").read_text())
    if on and not alive(pid):
        commands([dashboard / "scripts" / "verify" / "worker.sh"], timeout=120)
    if not on and alive(pid):
        os.killpg(pid, signal.SIGKILL)
        deadline = time.monotonic() + 10
        while alive(pid):
            if time.monotonic() >= deadline:
                raise RuntimeError(f"Inngest worker {pid} survived SIGKILL")
            time.sleep(0.1)


def install(run, backend, node, daemon):
    binaries, directory = daemon_binaries(run, daemon), daemon_artifacts(run, daemon)
    backend.exec(node, ["install", "-d", "/opt/ployz-verify"])
    paths = ["/opt/ployz-verify/" + name for name in binaries]
    result = backend.exec(node, ["sha256sum", *paths], check=False)
    staged = {line.split(maxsplit=1)[1]: line.split()[0] for line in result.stdout.decode().splitlines()}
    for name in binaries:
        destination = "/opt/ployz-verify/" + name
        if staged.get(destination) != binaries[name]:
            backend.push(node, directory / name, destination)
    backend.exec(node, ["bash", "-ec", """
observe=
if systemctl cat ployz-observe.service >/dev/null 2>&1; then observe=ployz-observe.service; fi
systemctl stop ployz.socket ployz.service ployz-volume-plugin.socket ployz-volume-plugin.service $observe
# Releases before 0.2.4 have no observer; a newer daemon's unit would outlive its binary.
if [ -e /etc/systemd/system/ployz-observe.service ]; then systemctl disable ployz-observe.service; fi
rm -f /etc/systemd/system/ployz-observe.service /run/systemd/system/ployz-observe.service
install -d -m 750 -o ployz -g ployz /run/ployz
for binary in "$@"; do
    if cmp -s "/opt/ployz-verify/$binary" "/usr/local/bin/$binary"; then continue; fi
    install -m 755 "/opt/ployz-verify/$binary" "/usr/local/bin/$binary.next"
    mv "/usr/local/bin/$binary.next" "/usr/local/bin/$binary"
done
# The exact installed version retains these binaries and writes their own units. Releases that
# install the observer in /etc need it enabled; later daemons start it themselves.
ployzd install --version "$(ployzd version)" --install-only
systemctl daemon-reload
observe=
if [ -e /etc/systemd/system/ployz-observe.service ]; then observe=ployz-observe.service; fi
systemctl enable --now ployz.socket ployz-volume-plugin.socket ployz.service $observe
""", "install", *binaries])


def require_running(run, backend, nodes):
    """Raise when a Machine in `nodes` is not running: Infrastructure unless `power off` stopped it."""
    lines, deliberate = [], True
    for node in nodes:
        state = backend.state(node)
        if state == "RUNNING":
            continue
        if node["name"] in run.get("powered_off", []):
            reason = "; `power off` stopped it"
        else:
            deliberate = False
            cause = backend.stop_cause(node) if state else None
            reason = ((f"; QEMU was terminated by {cause}" if cause else "; its QEMU log records no host kill") +
                      ("; see sudo journalctl -u earlyoom" if cause and "earlyoom" in cause else ""))
        lines.append(f"{node['name']} is {state.lower() or 'gone'}{reason}. "
                     f"Restart it: scripts/verify-cluster power on {run['manifest']} {node['name']}")
    if lines and deliberate:
        raise RuntimeError("\n".join(lines))
    if lines:
        raise Infrastructure("infrastructure failure, not a product result:\n" + "\n".join(lines))


def unintended(run):
    """Machines that should be running: every one `power off` did not stop."""
    return [node for node in run["machines"] if node["name"] not in run.get("powered_off", [])]


def doctor(run, commands, backend):
    require_running(run, backend, run["machines"])
    def inspect(node):
        daemon = node["daemon"]
        binaries = daemon_binaries(run, daemon)
        names = [name for name in binaries if name != "ployzd"]
        result = backend.exec(node, ["bash", "-ec", """
observe=
if systemctl cat ployz-observe.service >/dev/null 2>&1; then observe=ployz-observe.service; fi
systemctl is-active --quiet docker ssh ployz ployz.socket ployz-volume-plugin.socket ployz-dns $observe
pid=$(systemctl show ployz.service -p MainPID --value)
sha256sum "/proc/$pid/exe" "$@"
"/proc/$pid/exe" version
test -d /sys/module/zfs
zfs version
""", "doctor", *("/usr/local/bin/" + name for name in names)])
        lines = result.stdout.decode().splitlines()
        hashes = [line.split()[0] for line in lines[:1 + len(names)]]
        label = f"{daemon['source']} daemon {daemon['version']}"
        if hashes != [binaries["ployzd"], *(binaries[name] for name in names)]:
            raise RuntimeError(f"{node['name']}: running binaries differ from its {label}")
        if lines[1 + len(names)].strip() != daemon["version"]:
            raise RuntimeError(f"{node['name']}: running daemon reports {lines[1 + len(names)].strip()}, not its {label}")
        result = cli(run, commands, ["--json", "--connect", "ssh://" + node["ssh"], "server", "ls"])
        servers = json.loads(result.stdout)["servers"]
        expected_ids = {item["machine_id"] for item in run["machines"]}
        if {item["machine"]["id"] for item in servers} != expected_ids or any(item["membership"] != "up" for item in servers):
            raise RuntimeError(f"{node['name']}: expected {len(run['machines'])} reachable Machines")
        return {"machine": node["name"], "daemon": {**daemon, "running_sha256": binaries["ployzd"]}, "servers": servers}
    observations = parallel(inspect, run["machines"])
    if "cloud" in run:
        # Through Cloud's own Server Access, so Cloud must reach every Machine.
        servers = json.loads(cli(run, commands, ["--json", "server", "ls"]).stdout)["servers"]
        if {item["machine"]["id"] for item in servers} != {item["machine_id"] for item in run["machines"]}:
            raise RuntimeError(f"Cloud {run['cloud']['url']} does not list exactly this run's Machines")
        for item in servers:
            node = next(node for node in run["machines"] if node["machine_id"] == item["machine"]["id"])
            reported = (item["machine"].get("runtime") or {}).get("daemon_version")
            if reported != node["daemon"]["version"]:
                raise RuntimeError(f"Cloud reports daemon {reported} on {node['name']}, expected {node['daemon']['version']}")
        observations.append({"cloud": run["cloud"]["url"], "servers": servers})
    (commands.evidence / "doctor.json").write_text(json.dumps(observations, indent=2) + "\n")
    return observations


def wait_ready(run, commands, backend):
    deadline = time.monotonic() + 60
    while True:
        try:
            return doctor(run, commands, backend)
        except RuntimeError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.5)


def dns_soak_start(commands, backend, node, name, workload):
    gateway = backend.exec(node, ["bash", "-ec", "ip -4 -o addr show ployz | awk '{print $4}' | cut -d/ -f1"]).stdout.decode().strip()
    pid = ""
    if workload:
        pid = backend.exec(node, ["docker", "inspect", "--format", "{{.State.Pid}}", workload]).stdout.decode().strip()
    backend.push(node, CORE / "scripts" / "verify" / "dns-soak.sh", "/tmp/dns-soak.sh")
    backend.exec(node, ["bash", "-ec", f"setsid sh /tmp/dns-soak.sh {shlex.quote(gateway)} {shlex.quote(pid)} {shlex.quote(name)} "
                                       ">/tmp/dns-soak-log 2>&1 </dev/null &"])


def tcp_answers(stream):
    answered, bad = [], []
    while stream:
        length = int.from_bytes(stream[:2], "big")
        message, stream = stream[2:2 + length], stream[2 + length:]
        if len(message) < 12:
            bad.append("truncated message")
            break
        query_id = int.from_bytes(message[:2], "big")
        rcode, ancount = message[3] & 0x0F, int.from_bytes(message[6:8], "big")
        if rcode or not ancount:
            bad.append(f"#{query_id}: rcode {rcode}, {ancount} answers")
        answered.append(query_id)
    return sorted(answered), bad


def dns_soak_stop(commands, backend, node):
    backend.exec(node, ["bash", "-ec", """
touch /tmp/dns-soak.stop
for loop in tcp udp tcpdial workload; do
    while [ ! -e "/tmp/dns-soak.$loop-done" ]; do sleep 0.1; done
done
"""], timeout=30)
    def read(name):
        return backend.exec(node, ["sh", "-c", f"cat /tmp/dns-soak.{name} 2>/dev/null"], check=False).stdout
    report = {"machine": node["name"]}
    for loop in ["udp", "tcpdial", "workload"]:
        report[loop] = {"sent": int(read(loop + "-sent") or 0), "failed": read(loop + "-failed").decode(errors="replace").splitlines()}
    sent = int(read("tcp-sent") or 0)
    answered, bad = tcp_answers(read("tcp-out"))
    report["tcp"] = {"sent": sent, "answered": len(answered), "missing": sorted(set(range(1, sent + 1)) - set(answered)), "bad": bad,
                     "closed_at": read("tcp-closed").decode().strip() or None}
    (commands.evidence / f"dns-soak-{node['name']}.json").write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps(report))
    lost = report["udp"]["failed"] or report["tcpdial"]["failed"] or report["workload"]["failed"] or report["tcp"]["missing"] or report["tcp"]["bad"]
    return 1 if lost or not sent else 0


def teardown(run, commands, backend):
    run["state"] = "tearing-down"
    save(run)
    try:
        for node in run["machines"]:
            try:
                backend.exec(node, ["bash", "-c", "journalctl -u ployz -u ployz-dns -u ployz-observe -u ployz-volume-plugin -u docker -u ssh -u ssh.socket --no-pager -n 300; zpool status; zfs list; wg show"], check=False, timeout=10)
            except (RuntimeError, subprocess.TimeoutExpired):
                pass
    finally:
        # Evidence is best effort; a Machine that never got an address must not keep the rest alive.
        backend.destroy()
    private = Path(run["manifest"]).parent / "private"
    cloud = run.get("cloud", {})
    if cloud.get("owns_dashboard") and (private / "cloud-token").exists():
        # Only the instance this run started: a later up.sh reseeds with another token.
        try:
            started = dashboard_state(Path(cloud["dashboard"]))[1]["cliToken"] == (private / "cloud-token").read_text()
        except (OSError, StopIteration, ValueError, KeyError):
            started = False
        if started:
            commands([Path(cloud["dashboard"]) / "scripts" / "verify" / "down.sh"], check=False)
    shutil.rmtree(private, ignore_errors=True)
    run["state"] = "removed"
    save(run)


def age(seconds):
    seconds = int(seconds)
    return f"{seconds // 86400}d{seconds % 86400 // 3600}h" if seconds >= 86400 else f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def describe(run, now):
    """One host run as a row: what it holds and who answers for it."""
    record = run["owner"]
    running = [machine for machine in run["machines"] if machine["status"] == "Running"]
    live = {True: "live", False: "exited", None: "unknown"}[host.owner_live(record)]
    checkout = record.get("checkout", "unrecorded")
    return dict(run=run["id"], age="?" if run["created"] is None else age(now - run["created"]),
                machines=f"{len(running)}/{len(run['machines'])} running",
                ram=host.gib(sum(machine["memory"] for machine in running)),
                owner=f"{live} {record.get('session') or 'pid ' + record['pid'].partition(':')[0]}" if record else "unrecorded",
                checkout=checkout + ("" if checkout == "unrecorded" or Path(checkout).is_dir() else " (gone)"))


def table(rows, columns):
    widths = {column: max([len(column), *(len(str(row[column])) for row in rows)]) for column in columns}
    return "\n".join("  ".join(str(row[column]).ljust(widths[column]) for column in columns).rstrip()
                     for row in [{column: column.upper() for column in columns}, *rows])


def host_runs():
    """Every verify run on this host, from any checkout and provider."""
    found = []
    for name in PROVIDERS:
        if name == "incus" and not shutil.which("incus"):
            continue
        try:
            found += [{**run, "provider": name} for run in importlib.import_module(name).runs()]
        except (RuntimeError, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
            # One provider being unreachable must not hide or block the other's runs.
            print(f"Skipping {name} runs: {str(error).splitlines()[0]}", file=sys.stderr)
    return found


def preflight(args):
    """Refuse a launch the shared host cannot hold, naming the runs that hold it."""
    module = importlib.import_module(args.provider)
    if args.provider == "boat":
        if args.memory or args.disk:
            raise RuntimeError("--memory and --disk size Incus VMs; every Boat sandbox is the small type")
        module.preflight(args.machines, CORE)
        return
    memory = host.size(args.memory or module.DEFAULT_SIZES["memory"])
    meminfo = {line.split(":")[0]: int(line.split()[1]) * 1024 for line in Path("/proc/meminfo").read_text().splitlines()}
    try:
        pool, host_disk = module.capacity(os.environ.get("PLOYZ_VERIFY_INCUS_POOL", module.DEFAULT_POOL))
    except subprocess.CalledProcessError:
        # The pool does not exist yet; its first run creates it on the root filesystem.
        usage = shutil.disk_usage("/")
        pool, host_disk = (usage.free, usage.total), None
    runs = module.runs()
    reserve = {name: host.size(os.environ[variable]) for name, variable in
               [("memory_reserve", "PLOYZ_VERIFY_MEMORY_RESERVE"), ("disk_reserve", "PLOYZ_VERIFY_DISK_RESERVE")] if os.environ.get(variable)}
    problems = host.shortfalls(args.machines, memory, meminfo["MemAvailable"], meminfo["MemTotal"],
                               [machine for run in runs for machine in run["machines"]], pool, host_disk, **reserve)
    if problems:
        now = time.time()
        raise RuntimeError("This host cannot fit the run now.\n" + "\n".join(problems) + "\nVerify runs on this host:\n" +
                           table([describe(run, now) for run in runs], ["run", "age", "machines", "ram", "owner", "checkout"]) +
                           "\nDown your own finished runs; `scripts/verify-cluster reap` lists orphans it would remove.")


def reap(args):
    now, rows = time.time(), []
    for found in host_runs():
        if args.runs and found["id"] not in args.runs:
            continue
        remove, reason = host.verdict(found, now, int(args.older_than * 3600), args.force)
        rows.append({**describe(found, now), "action": ("remove" if remove else "keep"), "reason": reason})
        if not (remove and args.yes):
            continue
        manifest = Path(found["owner"].get("manifest", ""))
        if manifest.is_file() and json.loads(manifest.read_text()).get("id") == found["id"]:
            run = json.loads(manifest.read_text())
            try:
                with locked(run):
                    commands = Commands(run)
                    teardown(run, commands, provider(run, commands))
            except RuntimeError as error:
                rows[-1].update(action="failed", reason=str(error).splitlines()[0])
                continue
        else:
            # The manifest is gone, so evidence goes to the host cache.
            directory = Path.home() / ".cache" / "ployz" / "verify" / "reaped" / found["id"]
            directory.mkdir(parents=True, exist_ok=True)
            run = dict(id=found["id"], manifest=str(directory / "cluster.json"), provider=found["provider"], provider_state={},
                       machines=[dict(name=machine["name"]) for machine in found["machines"]])
            commands = Commands(run)
            provider(run, commands).destroy()
        rows[-1]["action"] = "removed"
    if not args.runs and shutil.which(boat.cli()[0]):
        try:
            rows += [dict(run=row["id"], action=row["action"], reason=row["reason"], age="", machines="pooled", ram="", owner="", checkout="")
                     for row in boat.reap_pool(args.force, args.yes)]
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            print(f"Skipping the Boat pool: {str(error).splitlines()[0]}", file=sys.stderr)
    print(table(rows, ["run", "action", "reason", "age", "machines", "ram", "owner", "checkout"]))
    if not args.yes and any(row["action"] == "remove" for row in rows):
        print("Dry run; pass --yes to remove the runs marked remove.", file=sys.stderr)


def up(args):
    total_started = time.monotonic()
    preflight(args)
    directory = CORE / ".verify" / (time.strftime("%Y%m%dT%H%M%S") + "-" + uuid.uuid4().hex[:10])
    directory.mkdir(parents=True, mode=0o700)
    private = directory / "private"
    (private / "bin").mkdir(parents=True, mode=0o700)
    (directory / "workspace").mkdir()
    run = dict(manifest=str(directory / "cluster.json"), root=str(CORE),
               owner=host.owner(CORE.parent, directory / "cluster.json"),
               id=directory.name.rsplit("-", 1)[1], provider=args.provider,
               provider_state={resource: size for resource, size in [("memory", args.memory), ("disk", args.disk)] if size}, state="starting",
               timings={}, machines=[dict(name=f"machine-{index}") for index in range(1, args.machines + 1)])
    save(run)
    commands = Commands(run)
    backend = provider(run, commands)
    print(f"Preparing verification run: {run['manifest']}", file=sys.stderr)
    paired = args.cloud or args.cloud_attach
    try:
        select_daemons(run, commands, args.daemon or [], default="checkout")
        # Cloud enrollment needs a daemon that speaks this CLI's protocol and reports its version; a release with
        # the same version string can predate the checkout's protocol. Other Machines enroll on the checkout
        # daemon and get their release afterwards.
        checkout = {"source": local_daemon([node["daemon"] for node in run["machines"]]) or "checkout",
                    "version": checkout_version()}
        head = commands(["git", "rev-parse", "HEAD"], cwd=CORE).stdout
        released = commands(["git", "rev-parse", "-q", "--verify", f"refs/tags/v{checkout['version']}^{{commit}}"],
                            cwd=CORE, check=False).stdout == head
        boot = {node["name"]: checkout if paired and node["daemon"]["source"] not in LOCAL
                and not (released and node["daemon"]["version"] == checkout["version"]) else node["daemon"]
                for node in run["machines"]}
        run["bridged"] = [name for name, daemon in boot.items() if daemon is checkout]
        booted = {daemon["version"] if daemon["source"] not in LOCAL else None for daemon in boot.values()}
        run["bootstrap_release"] = next(iter(booted)) if len(booted) == 1 and None not in booted else "0.2.2"
        save(run)
        # The context joins compilation and the dashboard before failure cleanup can remove resources.
        with ThreadPoolExecutor(max_workers=2) as builder:
            binaries = builder.submit(build, run, commands, daemon=local_daemon(
                [*boot.values(), *(node["daemon"] for node in run["machines"])]))
            if paired:
                cloud = builder.submit(pair_cloud, private, commands, owns=args.cloud)
            started = time.monotonic()
            backend.prepare()
            run["timings"]["prepare_image"] = round(time.monotonic() - started, 3)
            if binaries.done():
                binaries.result()
            started = time.monotonic()
            backend.create()
            commands(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", private / "id_ed25519"])
            ssh = shutil.which("ssh")
            wrapper = private / "bin" / "ssh"
            wrapper.write_text("#!/bin/sh\nexec " + shlex.quote(ssh) + " -o BatchMode=yes -o " +
                               shlex.quote("UserKnownHostsFile=" + str(private / "known_hosts")) +
                               " -i " + shlex.quote(str(private / "id_ed25519")) +
                               ' -o GlobalKnownHostsFile=/dev/null "$@"\n')
            wrapper.chmod(0o755)
            def start(node):
                backend.start(node)
                backend.push(node, private / "id_ed25519.pub", "/root/.ssh/authorized_keys")
                backend.exec(node, ["bash", "-ec", "chmod 700 /root/.ssh; chmod 600 /root/.ssh/authorized_keys; systemctl stop ssh.service ssh.socket; rm -f /etc/ssh/ssh_host_*; ssh-keygen -A; systemctl start ssh.socket ssh.service"])
                daemon = boot[node["name"]]
                if daemon["source"] in LOCAL or daemon["version"] != run["bootstrap_release"]:
                    binaries.result()
                    install(run, backend, node, daemon)
                else:
                    # The release and its units are already installed in this image.
                    backend.exec(node, ["bash", "-ec", """
observe=
if [ -e /etc/systemd/system/ployz-observe.service ]; then observe=ployz-observe.service; fi
systemctl enable --now ployz.socket ployz-volume-plugin.socket ployz.service $observe
"""])
                node["address"] = backend.address(node)
                node["ssh"], node["endpoint"] = backend.ssh(node), endpoint(node["address"])
            parallel(start, run["machines"])
            binaries.result()
            if paired:
                run["cloud"] = cloud.result()
        run["timings"]["boot_and_install"] = round(time.monotonic() - started, 3)
        save(run)
        started = time.monotonic()
        for node in run["machines"]:
            # Cloud enrollment currently ignores --public-ip and --wg-endpoint; the Machine advertises the endpoints it discovers.
            # --no-install requires --storage none, yet managed Volumes work: the image ran `ployzd install --storage zfs`,
            # and the daemon creates the Machine Pool on the first Volume, as on a real Server.
            result = cli(run, commands, ["--json", "server", "add", node["ssh"],
                               *([] if "cloud" in run else ["--standalone"]), "--no-install", "--storage", "none", "--yes",
                               "--name", node["name"], "--ssh-key", str(private / "id_ed25519"),
                               "--public-ip", "none", "--wg-endpoint", node["endpoint"], "--wg-mtu", "1420"], check=False)
            response = json.loads(result.stdout) if result.stdout else {}
            follow_up = response.get("follow_up_error", {})
            if result.returncode and not (result.returncode == 3 and response.get("server") and follow_up.get("code") == "unavailable"):
                raise RuntimeError(f"{node['name']}: enrollment failed: {result.stderr.decode(errors='replace')}\nEvidence: {commands.evidence}")
            node["machine_id"] = response["server"]["machine"]["id"]
            if result.returncode:
                # Initialization committed, but the published daemon can serve
                # before its Cluster network row is visible. Observe readiness;
                # rerunning `add --yes` would reset the committed founder.
                run.setdefault("setup_follow_up_errors", []).append({"machine": node["name"], **follow_up})
                print(f"{node['name']}: enrollment committed with a follow-up failure; checking readiness. Evidence: {commands.evidence}", file=sys.stderr)
                deadline = time.monotonic() + 30
                while True:
                    observed = cli(run, commands, ["--json", "--connect", "ssh://" + node["ssh"], "server", "ls"], check=False, timeout=5)
                    if not observed.returncode and any(server["machine"]["id"] == node["machine_id"] and server["membership"] == "up"
                            for server in json.loads(observed.stdout)["servers"]):
                        break
                    if time.monotonic() >= deadline:
                        raise RuntimeError(f"{node['name']}: committed enrollment never became ready; see {commands.evidence}")
                    time.sleep(0.25)
                # Complete the same Ingress Proxy follow-up offered by the CLI.
                cli(run, commands, ["--json", "server", "set", node["machine_id"], "--accepts-ingress=true"])
            save(run)
        bridged = [node for node in run["machines"] if node["name"] in run["bridged"]]
        if bridged:
            print("Enrolled on the checkout daemon; installing " +
                  ", ".join(f"{node['name']}={node['daemon']['version']}" for node in bridged), file=sys.stderr)
            parallel(lambda node: install(run, backend, node, node["daemon"]), bridged)
        wait_ready(run, commands, backend)
        run["timings"]["join_and_ready"] = round(time.monotonic() - started, 3)
        run["state"] = "ready"
        run["timings"]["total"] = round(time.monotonic() - total_started, 3)
        save(run)
        print(run["manifest"])
        print(json.dumps(run["timings"]), file=sys.stderr)
    except BaseException:
        print(f"Setup failed; cleaning up. Evidence: {commands.evidence}", file=sys.stderr)
        teardown(run, commands, backend)
        if args.cloud and "cloud" not in run:
            commands([DASHBOARD / "scripts" / "verify" / "down.sh"], check=False)
        raise


@contextmanager
def locked(run):
    with Path(run["manifest"]).with_suffix(".lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("Another update or teardown is using this run") from None
        yield


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest="action", required=True)
    launch = actions.add_parser("up", help="Boot a new disposable cluster")
    launch.add_argument("--provider", choices=PROVIDERS, default="incus",
                        help="Where Machines run: incus VMs on this host, or boat sandboxes")
    launch.add_argument("--machines", type=int, choices=range(1, 9), default=1)
    daemon_help = ("[MACHINE=]SOURCE, repeatable. SOURCE is checkout, main (main's CI build, stale), stable, beta or an exact release version; "
                   "a bare SOURCE sets every Machine and MACHINE=SOURCE overrides one")
    launch.add_argument("--daemon", action="append", metavar="[MACHINE=]SOURCE", help=daemon_help + "; checkout by default")
    launch.add_argument("--memory", help="RAM per Machine VM as an Incus size; 2GiB by default; Incus only")
    launch.add_argument("--disk", help="Root disk per Machine VM, which bounds its Machine Pool; 24GiB by default; Incus only")
    pairing = launch.add_mutually_exclusive_group()
    pairing.add_argument("--cloud", action="store_true",
                         help="Start this checkout's dashboard verify instance and enroll through it; down stops it")
    # dashboard/scripts/verify/up.sh started the dashboard and owns it.
    pairing.add_argument("--cloud-attach", action="store_true", help=argparse.SUPPRESS)
    listing = actions.add_parser("ls", help="List every verify run on this host, from any checkout")
    listing.add_argument("--json", action="store_true")
    reaping = actions.add_parser("reap", help="Remove runs whose checkout or manifest is gone or that are old; a dry run without --yes")
    reaping.add_argument("runs", nargs="*", metavar="RUN", help="Only consider these run ids")
    reaping.add_argument("--older-than", type=float, default=24, metavar="HOURS", help="Age that makes a run removable; 24 by default")
    reaping.add_argument("--force", action="store_true", help="Also remove runs whose owner process is still alive")
    reaping.add_argument("--yes", action="store_true", help="Remove the runs marked remove")
    for action in ["doctor", "update", "down", "exec", "cli", "power", "partition", "runner", "probe", "dns-soak"]:
        command = actions.add_parser(action)
        if action in ["power", "partition"]:
            command.add_argument("state", choices=["on", "off"])
        if action == "runner":
            command.add_argument("state", choices=["kill", "start"])
        if action == "dns-soak":
            command.add_argument("state", choices=["start", "stop"],
                                 help="Query the Machine's Internal DNS over UDP, one persistent TCP connection and a TCP dial per query until stop; "
                                      "stop writes evidence/dns-soak-<machine>.json and fails on any lost lookup")
            command.add_argument("--name", default="dns-api.app.internal", help="The name to resolve, SERVICE.NAMESPACE.internal")
            command.add_argument("--workload", help="Also resolve through 127.0.0.11 inside this container")
        command.add_argument("manifest", type=Path)
        if action in ["power", "partition", "dns-soak"]:
            command.add_argument("machine", help="machine-1, machine-2, …")
        if action == "probe":
            command.add_argument("service", help="A Postgres Service; acknowledged ids are logged in evidence/")
            command.add_argument("--user", default="postgres")
            command.add_argument("--database", default="postgres")
            command.add_argument("--rate", type=float, default=200, help="Inserts per second")
            command.add_argument("--stall", type=float, default=2,
                                 help="Seconds an insert may wait for its acknowledgement before the probe reconnects")
        if action == "update":
            command.add_argument("--daemon", action="append", metavar="[MACHINE=]SOURCE",
                                 help=daemon_help + "; Machines not named keep their source")
        if action == "exec":
            command.add_argument("machine", help="machine-1, machine-2, …")
        if action in ["exec", "cli"]:
            command.add_argument("--timeout", type=float, default=300, help="Command deadline in seconds")
            command.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.action == "up":
        up(args)
        return 0
    if args.action == "ls":
        now = time.time()
        rows = [describe(found, now) for found in host_runs()]
        parked = boat.pooled()
        print(json.dumps({"runs": rows, "pool": parked}) if args.json else table(rows, ["run", "age", "machines", "ram", "owner", "checkout"]))
        if not args.json:
            for image, count in sorted(parked.items()):
                print(f"Boat pool: {count} parked ({image})")
        return 0
    if args.action == "reap":
        reap(args)
        return 0
    run = json.loads(args.manifest.read_text())
    for node in run["machines"]:
        # Manifests written before ssh and endpoint were split out record only the address.
        if "address" in node:
            node.setdefault("ssh", "root@" + node["address"])
            node.setdefault("endpoint", endpoint(node["address"]))
    if run["root"] != str(CORE) or Path(run["manifest"]).resolve() != args.manifest.resolve():
        raise RuntimeError("Use this run's originating checkout and manifest path")
    if run["state"] == "removed":
        if args.action == "down":
            print(f"Already removed. Evidence: {args.manifest.parent / 'evidence'}")
            return 0
        raise RuntimeError("This cluster has been removed")
    commands = Commands(run)
    backend = provider(run, commands)
    if run["provider"] == "boat" and args.action != "down":
        backend.refresh()
    machine = next((node for node in run["machines"] if node["name"] == getattr(args, "machine", None)), None)
    if hasattr(args, "machine") and machine is None:
        raise RuntimeError(f"Unknown Machine: {args.machine}")
    if args.action == "power":
        power(backend, machine, args.state == "on")
        # A Machine this run cut is down by intent, so its failures stay product results.
        run["powered_off"] = sorted(set(run.get("powered_off", [])) - {machine["name"]} | ({machine["name"]} if args.state == "off" else set()))
        save(run)
        return 0
    if args.action == "partition":
        partition(run, backend, machine, args.state == "on")
        return 0
    if args.action == "runner":
        runner(run, commands, args.state == "start")
        return 0
    if args.action == "dns-soak":
        if args.state == "start":
            dns_soak_start(commands, backend, machine, args.name, args.workload)
            return 0
        return dns_soak_stop(commands, backend, machine)
    if args.action == "probe":
        ployz, environment, workspace = cli_environment(run)
        result = importlib.import_module("ackprobe").run(
            ployz, environment, workspace, commands.evidence, service=args.service,
            user=args.user, database=args.database, rate=args.rate, stall=args.stall)
        print(json.dumps(result))
        if result["lost"]:
            require_running(run, backend, unintended(run))
        return 1 if result["lost"] else 0
    if args.action in ["exec", "cli"]:
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if not command:
            raise RuntimeError("Supply a command after --")
        # The passthroughs forward the caller's stdin, as the commands they wrap do.
        if args.action == "cli":
            result = cli(run, commands, command, check=False, timeout=args.timeout, stdin=None)
        else:
            result = backend.exec(machine, command, check=False, timeout=args.timeout, stdin=None)
        sys.stdout.buffer.write(result.stdout)
        sys.stderr.buffer.write(result.stderr)
        if result.returncode:
            sys.stdout.flush()
            sys.stderr.flush()
            require_running(run, backend, [machine] if machine else unintended(run))
        return result.returncode
    if args.action == "doctor":
        print(json.dumps(doctor(run, commands, backend), indent=2))
        return 0
    with locked(run):
        if args.action == "down":
            teardown(run, commands, backend)
            print(f"Removed cluster. Evidence: {commands.evidence}")
        else:
            select_daemons(run, commands, args.daemon or [], default="checkout")
            build(run, commands, daemon=local_daemon([node["daemon"] for node in run["machines"]]))
            started = time.monotonic()
            parallel(lambda node: install(run, backend, node, node["daemon"]), run["machines"])
            wait_ready(run, commands, backend)
            run["timings"]["update_and_ready"] = round(time.monotonic() - started, 3)
            save(run)
            print(json.dumps(run["timings"]))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Infrastructure as error:
        print(f"verify-cluster: {error}", file=sys.stderr)
        sys.exit(host.INFRASTRUCTURE)
    except (RuntimeError, subprocess.TimeoutExpired, OSError) as error:
        print(f"verify-cluster: {error}", file=sys.stderr)
        sys.exit(1)
